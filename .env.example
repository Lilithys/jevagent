PORT=3210
DATA_DIR=./data
# Use installed Chrome, or run npm run browser:install and set BROWSER_CHANNEL=chromium
BROWSER_CHANNEL=chrome
# Optional real Jev policy. Without a key, the explicitly labelled local policy is used.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Exact extra origins that you explicitly allow the agent to operate on (comma-separated).
ALLOWED_ORIGINS=
# Optional explicitly created login state. Generate with: npm run auth -- https://your-app.example.com
# Keep this file private; it contains session cookies. Never commit it.
BROWSER_STORAGE_STATE=
